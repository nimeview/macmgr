#castom
alt - return : open -na /Applications/kitty.app
alt - q : /usr/local/bin/yabai -m window --close

alt - h : /usr/local/bin/yabai -m window --focus west
alt - j : /usr/local/bin/yabai -m window --focus south
alt - k : /usr/local/bin/yabai -m window --focus north
alt - l : /usr/local/bin/yabai -m window --focus east

alt + shift - h : /usr/local/bin/yabai -m window --warp west
alt + shift - j : /usr/local/bin/yabai -m window --warp south
alt + shift - k : /usr/local/bin/yabai -m window --warp north
alt + shift - l : /usr/local/bin/yabai -m window --warp east

## Spaces 1–9
# Физические keycodes цифр (не зависят от RU/EN раскладки)
# 1=0x12 2=0x13 3=0x14 4=0x15 5=0x17 6=0x16 7=0x1A 8=0x1C 9=0x19
# Основной хорд: Left Option + цифра (правый Option часто для раскладки)
lalt - 0x12 : /usr/local/bin/yabai -m space --focus 1
lalt - 0x13 : /usr/local/bin/yabai -m space --focus 2
lalt - 0x14 : /usr/local/bin/yabai -m space --focus 3
lalt - 0x15 : /usr/local/bin/yabai -m space --focus 4
lalt - 0x17 : /usr/local/bin/yabai -m space --focus 5
lalt - 0x16 : /usr/local/bin/yabai -m space --focus 6
lalt - 0x1A : /usr/local/bin/yabai -m space --focus 7
lalt - 0x1C : /usr/local/bin/yabai -m space --focus 8
lalt - 0x19 : /usr/local/bin/yabai -m space --focus 9

# Запасной: Ctrl + Left Option + цифра (если Option+цифра ест раскладка)
lctrl + lalt - 0x12 : /usr/local/bin/yabai -m space --focus 1
lctrl + lalt - 0x13 : /usr/local/bin/yabai -m space --focus 2
lctrl + lalt - 0x14 : /usr/local/bin/yabai -m space --focus 3
lctrl + lalt - 0x15 : /usr/local/bin/yabai -m space --focus 4
lctrl + lalt - 0x17 : /usr/local/bin/yabai -m space --focus 5
lctrl + lalt - 0x16 : /usr/local/bin/yabai -m space --focus 6
lctrl + lalt - 0x1A : /usr/local/bin/yabai -m space --focus 7
lctrl + lalt - 0x1C : /usr/local/bin/yabai -m space --focus 8
lctrl + lalt - 0x19 : /usr/local/bin/yabai -m space --focus 9

# Перенести окно на стол + фокус
shift + lalt - 0x12 : /usr/local/bin/yabai -m window --space 1; /usr/local/bin/yabai -m space --focus 1
shift + lalt - 0x13 : /usr/local/bin/yabai -m window --space 2; /usr/local/bin/yabai -m space --focus 2
shift + lalt - 0x14 : /usr/local/bin/yabai -m window --space 3; /usr/local/bin/yabai -m space --focus 3
shift + lalt - 0x15 : /usr/local/bin/yabai -m window --space 4; /usr/local/bin/yabai -m space --focus 4
shift + lalt - 0x17 : /usr/local/bin/yabai -m window --space 5; /usr/local/bin/yabai -m space --focus 5
shift + lalt - 0x16 : /usr/local/bin/yabai -m window --space 6; /usr/local/bin/yabai -m space --focus 6
shift + lalt - 0x1A : /usr/local/bin/yabai -m window --space 7; /usr/local/bin/yabai -m space --focus 7
shift + lalt - 0x1C : /usr/local/bin/yabai -m window --space 8; /usr/local/bin/yabai -m space --focus 8
shift + lalt - 0x19 : /usr/local/bin/yabai -m window --space 9; /usr/local/bin/yabai -m space --focus 9

# Window Navigation (through display borders): lalt - {j, k, l}
lalt - j    : yabai -m window --focus west  || yabai -m display --focus west
lalt - k    : yabai -m window --focus south || yabai -m display --focus south
lalt - l    : yabai -m window --focus north || yabai -m display --focus north
lalt - 0x29 : yabai -m window --focus east  || yabai -m display --focus east

# Extended Window Navigation: lalt - {h, ä}
lalt -    h : yabai -m window --focus first
lalt - 0x27 : yabai -m window --focus  last

# Float / Unfloat window: lalt - space
lalt - space : yabai -m window --toggle float

# Make window zoom to fullscreen: shift + lalt - f
shift + lalt - f : yabai -m window --toggle zoom-fullscreen

# Make window zoom to parent node: lalt - f 
lalt - f : yabai -m window --toggle zoom-parent

